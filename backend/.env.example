PORT=5000
NODE_ENV=development
# Neon Serverless PostgreSQL connection string (pooled connection recommended)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET=super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
